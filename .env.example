PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=store_rating_app

# CHANGE THIS: generate with `openssl rand -base64 48`
JWT_SECRET=INVALID_REPLACE_WITH_GENERATED_SECRET
JWT_EXPIRES_IN_SECONDS=3600

# Comma-separated browser origins; defaults to localhost:3000 and :5173 only in development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
